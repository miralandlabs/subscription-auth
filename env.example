# Required for persistence routes
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Challenge HMAC (≠ PR402_ONBOARD_HMAC_SECRET) — must be ≥ 32 bytes
SUBSCRIPTION_AUTH_HMAC_SECRET=Todo-change-me-at-least-32-bytes-long-secret!!

# RS256 signing — note: newlines in the PEM must be escaped as \n for Vercel env vars
# Run: openssl genrsa -out private.pem 2048 && awk 'NF{printf "%s\\n",$0}' private.pem
SUBSCRIPTION_AUTH_RSA_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
SUBSCRIPTION_AUTH_KEY_ID=auth-key-1
SUBSCRIPTION_AUTH_ISS=https://auth.example.com

# How many days back the revocation feed extends (default: 7).
# Sellers polling /v1/revocations with a `since` older than this will get an empty result.
# SUBSCRIPTION_AUTH_REVOCATION_WINDOW_DAYS=7

# Set to true ONLY in local dev with self-signed Postgres certs (e.g. docker-compose).
# Never use in production — leaves TLS connections vulnerable to MITM.
# SUBSCRIPTION_AUTH_SSL_NO_VERIFY=false

# Optional
RUST_LOG=subscription_auth=info,server_log=info
