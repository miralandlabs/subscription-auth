# subscription-auth — copy these into a .env file in this folder
# (rename this file to .env, fill in real values)

# ── Where your subscription-auth is deployed ──────────────────────────────────
SUBSCRIPTION_AUTH_BASE_URL=https://YOUR-DEPLOYMENT.vercel.app
SUBSCRIPTION_AUTH_ISS=https://YOUR-DEPLOYMENT.vercel.app
SUBSCRIPTION_AUTH_SERVICE_ID=api.myproduct.com

# ── Your seller wallet keypair ────────────────────────────────────────────────
# Path to the 64-byte Solana keypair JSON file you registered with
MERCHANT_KEYPAIR_PATH=../../../demo-wallets/seller-keypair.json
# The public key of that wallet (run: solana-keygen pubkey <keypair.json>)
MERCHANT_WALLET=YourWalletPublicKeyHere

# ── This example server ───────────────────────────────────────────────────────
PORT=3000
